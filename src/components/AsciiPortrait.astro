---
import asciiArt from '../data/ascii-portrait.txt?raw';
---

<aside class="ascii-portrait reveal" aria-label="ASCII portrait of Thiego">
    <p class="ascii-portrait__label mono">// self-portrait.render()</p>
    <pre class="ascii-portrait__art">{asciiArt}</pre>
</aside>

<style>
    .ascii-portrait {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.85rem;
        padding: calc(var(--gutter) * 1.4) 0 calc(var(--gutter) * 1.6);
    }

    .ascii-portrait__label {
        margin: 0;
        font-size: 0.72rem;
        color: var(--text-dim);
        letter-spacing: 0.04em;
    }

    .ascii-portrait__art {
        font-family: var(--font-mono);
        font-size: 0.2rem;
        line-height: 1;
        color: var(--text-muted);
        margin: 0 auto;
        padding: 0;
        max-width: 100%;
        white-space: pre;
        text-align: center;
        overflow: hidden;
    }

    @media (min-width: 720px) {
        .ascii-portrait__art {
            font-size: 0.3rem;
        }
    }
</style>
