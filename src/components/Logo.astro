---
interface Props {
    color?: string;
    size?: number;
    class?: string;
    ariaLabel?: string;
}

const {
    color = 'var(--text)',
    size = 32,
    class: className,
    ariaLabel = 'Thiego Moura',
} = Astro.props;
---
<span
    class:list={['logo-mark', className]}
    style={`--logo-color:${color};--logo-size:${size}px;`}
    role="img"
    aria-label={ariaLabel}
></span>

<style>
    .logo-mark {
        display: inline-block;
        width: var(--logo-size, 32px);
        aspect-ratio: 1932 / 1203.41;
        background-color: var(--logo-color, var(--text));
        mask-image: url(/logo.svg);
        mask-size: contain;
        mask-repeat: no-repeat;
        mask-position: center;
        -webkit-mask-image: url(/logo.svg);
        -webkit-mask-size: contain;
        -webkit-mask-repeat: no-repeat;
        -webkit-mask-position: center;
    }
</style>
