---
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
    href === '/' ? path === '/' : path === href || path.startsWith(href + '/');

const links = [
    { href: '/', label: 'Index' },
    { href: '/projects', label: 'Projects' },
    { href: '/articles', label: 'Articles' },
    { href: '/adrs', label: 'ADRs' },
];
---
<header class="nav-root">
    <div class="nav-inner">
        <a class="nav-brand" href="/">
            <Logo size={32} />
            <span class="nav-brand__name">Thiego Moura</span>
        </a>
        <nav id="nav-menu" class="nav-links" aria-label="Primary">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class:list={['nav-link', { 'is-active': isActive(link.href) }]}
                    >
                        {link.label}
                    </a>
                ))
            }
        </nav>
        <ThemeToggle />
        <button
            id="nav-toggle"
            class="nav-toggle"
            type="button"
            aria-controls="nav-menu"
            aria-expanded="false"
            aria-label="Open menu"
            title="Toggle menu"
        >
            <span class="nav-toggle__icon" data-icon>☰</span>
        </button>
    </div>
</header>

<script is:inline>
    (function () {
        var root = document.querySelector('.nav-root');
        var btn = document.getElementById('nav-toggle');
        var icon = btn && btn.querySelector('[data-icon]');
        if (!root || !btn) return;

        function setOpen(open) {
            root.classList.toggle('is-open', open);
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
            btn.setAttribute('title', open ? 'Close menu' : 'Open menu');
            if (icon) icon.textContent = open ? '\u2715' : '\u2630';
        }

        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            setOpen(!root.classList.contains('is-open'));
        });

        document.addEventListener('click', function (e) {
            if (root.classList.contains('is-open') && !root.contains(e.target)) {
                setOpen(false);
            }
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && root.classList.contains('is-open')) {
                setOpen(false);
                btn.focus();
            }
        });
    })();
</script>

<style>
    .nav-root {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in oklab, var(--bg) 86%, transparent);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--hairline);
    }

    .nav-inner {
        width: min(1100px, calc(100% - 2 * var(--gutter)));
        margin: 0 auto;
        display: grid;
        grid-template-columns: auto 1fr auto auto;
        align-items: center;
        gap: 1.2rem;
        padding: 0.9rem 0;
    }

    .nav-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 600;
    }

    .nav-brand__name {
        font-size: 0.95rem;
    }

    .nav-links {
        display: flex;
        gap: 0.4rem;
        justify-content: center;
    }

    .nav-link {
        font-family: var(--font-mono);
        font-size: 0.82rem;
        font-weight: 500;
        padding: 0.35em 0.7em;
        color: var(--text-muted);
        border: 1px solid transparent;
        transition: color var(--duration) var(--ease), border-color var(--duration) var(--ease);
    }

    .nav-link:hover {
        color: var(--text);
    }

    .nav-link.is-active {
        color: var(--text);
        border-color: var(--border);
    }

    .nav-toggle {
        display: none;
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text);
        padding: 0.4em 0.6em;
        cursor: pointer;
        font-size: 1rem;
        line-height: 1;
        align-items: center;
        justify-content: center;
        transition: border-color var(--duration) var(--ease), background-color var(--duration) var(--ease);
    }

    .nav-toggle:hover {
        border-color: var(--text-dim);
        background: var(--surface);
    }

    .nav-toggle__icon {
        font-size: 1.05rem;
        line-height: 1;
    }

    @media (max-width: 640px) {
        .nav-inner {
            grid-template-columns: 1fr auto auto;
            row-gap: 0;
        }

        .nav-toggle {
            display: inline-flex;
        }

        .nav-links {
            display: none;
            grid-column: 1 / -1;
            flex-direction: column;
            gap: 0;
            padding: 0.6rem 0 0.3rem;
            border-top: 1px solid var(--hairline);
            margin-top: 0.6rem;
        }

        .nav-root.is-open .nav-links {
            display: flex;
        }

        .nav-link {
            display: block;
            padding: 0.7rem 0;
            font-size: 0.9rem;
            border-bottom: 1px solid var(--hairline);
        }

        .nav-link:last-child {
            border-bottom: 0;
        }
    }
</style>
