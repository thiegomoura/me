<svg viewBox="0 0 760 220" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Offline-first sync architecture">
    <defs>
        <marker id="arrow-sync" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" fill="#34d399" />
        </marker>
    </defs>
    <g font-family="Inter, system-ui, sans-serif" font-size="13" fill="currentColor">
        <rect x="20" y="40" width="150" height="60" rx="6" fill="none" stroke="#34d399" />
        <text x="95" y="68" text-anchor="middle" font-weight="700">Mobile Client</text>
        <text x="95" y="86" text-anchor="middle" opacity="0.7">Local store + queue</text>
        <rect x="240" y="40" width="180" height="60" rx="6" fill="none" stroke="#34d399" />
        <text x="330" y="68" text-anchor="middle" font-weight="700">Sync API (NestJS)</text>
        <text x="330" y="86" text-anchor="middle" opacity="0.7">batch + delta + conflicts</text>
        <rect x="490" y="40" width="150" height="60" rx="6" fill="none" stroke="#34d399" />
        <text x="565" y="68" text-anchor="middle" font-weight="700">PostgreSQL</text>
        <text x="565" y="86" text-anchor="middle" opacity="0.7">versioned rows</text>
        <rect x="240" y="140" width="180" height="50" rx="6" fill="none" stroke="currentColor" opacity="0.5" />
        <text x="330" y="170" text-anchor="middle" font-weight="600" opacity="0.7">Conflict Resolver</text>
        <line x1="170" y1="70" x2="240" y2="70" stroke="#34d399" stroke-width="2" marker-end="url(#arrow-sync)" />
        <line x1="420" y1="70" x2="490" y2="70" stroke="#34d399" stroke-width="2" marker-end="url(#arrow-sync)" />
        <line x1="330" y1="100" x2="330" y2="140" stroke="#34d399" stroke-width="2" marker-end="url(#arrow-sync)" />
    </g>
</svg>
