---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
    const articles = await getCollection('articles');
    return articles
        .filter((a) => !a.data.draft)
        .map((a) => ({
            params: { slug: a.id.replace(/\.md$/, '') },
            props: { article: a },
        }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const date = article.data.pubDate.toISOString().slice(0, 10);
---
<BaseLayout title={article.data.title} pageClass="page-article">
    <article class="article reveal">
        <header class="article-header">
            <p class="article-meta mono">
                <span>{date}</span>
                {article.data.tags.length > 0 && (
                    <>
                        <span class="article-meta-sep">/</span>
                        <span>{article.data.tags.map((t) => `#${t}`).join(' ')}</span>
                    </>
                )}
            </p>
            <h1 class="article-title">{article.data.title}</h1>
            <p class="article-desc">{article.data.description}</p>
        </header>

        <div class="article-body">
            <Content />
        </div>

        <footer class="article-footer">
            <a class="btn btn--ghost" href="/articles">← All articles</a>
        </footer>
    </article>
</BaseLayout>

<style>
    .article {
        max-width: 100%;
    }

    .article-header {
        padding: calc(var(--gutter) * 0.5) 0 var(--gutter);
        border-bottom: 1px solid var(--hairline);
        margin-bottom: var(--gutter);
    }

    .article-meta {
        margin: 0 0 0.7rem;
        font-size: 0.75rem;
        color: var(--text-dim);
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        align-items: center;
    }

    .article-meta-sep {
        color: var(--border);
    }

    .article-title {
        font-size: clamp(1.7rem, 3.6vw, 2.4rem);
        line-height: 1.1;
        letter-spacing: -0.03em;
        font-weight: 700;
        margin: 0 0 0.7rem;
    }

    .article-desc {
        font-size: 1.05rem;
        line-height: 1.6;
        color: var(--text-muted);
        margin: 0;
        max-width: 60ch;
    }

    .article-body :global(h2) {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--text-dim);
        margin: calc(var(--gutter) * 1.2) 0 0.7rem;
        padding-top: 0.5rem;
        display: flex;
        align-items: baseline;
        gap: 0.5em;
    }

    .article-body :global(h2::before) {
        content: '>';
        color: var(--text-dim);
    }

    .article-body :global(h3) {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--text);
        margin: 1.4rem 0 0.5rem;
    }

    .article-body :global(p),
    .article-body :global(li) {
        color: var(--text-muted);
        line-height: 1.75;
        font-size: 1rem;
    }

    .article-body :global(p) {
        margin: 0 0 1rem;
    }

    .article-body :global(ul) {
        list-style: none;
        margin: 0 0 1rem;
        padding: 0;
    }

    .article-body :global(ul li) {
        display: grid;
        grid-template-columns: 2.5ch 1fr;
        gap: 0.5em;
        align-items: baseline;
        margin-bottom: 0.4rem;
    }

    .article-body :global(ul li::before) {
        content: '✓';
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--accent);
        line-height: 1;
        position: relative;
        top: 1px;
    }

    .article-body :global(ol) {
        padding-left: 1.4rem;
        margin: 0 0 1rem;
    }

    .article-body :global(ol li) {
        margin-bottom: 0.4rem;
    }

    .article-body :global(code) {
        font-family: var(--font-mono);
        font-size: 0.88em;
        background: var(--surface-2);
        padding: 0.1em 0.35em;
        border: 1px solid var(--border);
    }

    .article-body :global(pre) {
        background: var(--surface-2);
        border: 1px solid var(--border);
        padding: 1rem 1.2rem;
        overflow-x: auto;
        margin: 0 0 1rem;
    }

    .article-body :global(pre code) {
        background: none;
        border: 0;
        padding: 0;
    }

    .article-body :global(blockquote) {
        margin: 0 0 1rem;
        padding: 0.4rem 0 0.4rem 1rem;
        border-left: 3px solid var(--accent);
        color: var(--text);
    }

    .article-body :global(a) {
        color: var(--text);
        border-bottom: 1px solid var(--text-dim);
    }

    .article-body :global(a:hover) {
        color: var(--accent);
        border-bottom-color: var(--accent);
    }

    .article-body :global(strong) {
        color: var(--text);
    }

    .article-footer {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-top: var(--section-gap);
        padding-top: calc(var(--gutter) * 1.2);
        border-top: 1px solid var(--hairline);
    }
</style>
