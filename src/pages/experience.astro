---
import BaseLayout from '../layouts/BaseLayout.astro';
import Experience from '../components/Experience.astro';
import data from '../data/experience.json';
---
<BaseLayout title="Experience" pageClass="page-experience">
    <header class="page-header reveal">
        <h1>Experience</h1>
        <p>
            A decade-long path from IT support to backend engineering — promotions, a pivot into
            software, and an ongoing bet on AI. The work that pays the bills, the education that
            made the pivot possible, and the milestones that shaped the trajectory.
        </p>
    </header>

    <section class="section">
        <h2 class="section-title">Where I've worked</h2>
        <Experience
            experiences={data.experiences}
            education={data.education}
            milestones={data.milestones}
        />
    </section>
</BaseLayout>

<style>
    .page-header {
        padding: calc(var(--gutter) * 0.5) 0 var(--gutter);
    }

    .page-header h1 {
        font-size: clamp(1.9rem, 3.4vw, 2.4rem);
        line-height: 1.1;
        letter-spacing: -0.03em;
        margin: 0 0 0.7rem;
    }

    .page-header p {
        font-size: 1.02rem;
        line-height: 1.7;
        color: var(--text-muted);
        max-width: 60ch;
        margin: 0;
    }
</style>
