---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import AsciiPortrait from "../components/AsciiPortrait.astro";
import SkillGroup from "../components/SkillGroup.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { readingTime, formatReadingTime } from "../utils/reading-time";

const stats = [
    { value: "5+ years", label: "building production backends" },
    { value: "10+ APIs", label: "in production today" },
    { value: "99.95%", label: "SLA maintained" },
];

const deliverables = [
    "Cut a critical endpoint from 14s to 150ms — ~99% latency reduction through query optimization, processing improvements, and caching.",
    "Took CI from 20min to 12min and added obfuscation + minification across the pipeline.",
    "Designed a generic, table-agnostic offline-first sync service used across multiple product modules.",
    "Architect with Clean Architecture and DDD — I ship code that other engineers want to read.",
];

const skills = [
    {
        title: "Languages & Runtimes",
        level: "Daily use",
        items: ["TypeScript", "JavaScript", "Node.js", "Python", "Shell"],
    },
    {
        title: "Backend & APIs",
        level: "Primary stack",
        items: [
            "Nest.js",
            "Express",
            "Fastify",
            "REST",
            "GraphQL",
            "gRPC",
            "Clean Architecture",
            "DDD",
        ],
    },
    {
        title: "Data & Messaging",
        level: "Production",
        items: ["PostgreSQL", "MongoDB", "Redis", "RabbitMQ", "DynamoDB"],
    },
    {
        title: "Cloud & Delivery",
        level: "Hands-on",
        items: [
            "AWS",
            "Azure",
            "Docker",
            "Kubernetes",
            "Terraform",
            "Lambda",
            "CI/CD",
            "GitHub Actions",
        ],
    },
    {
        title: "Observability & Quality",
        level: "Operate what you ship",
        items: [
            "OpenTelemetry",
            "Prometheus",
            "Grafana",
            "Jest",
            "Vitest",
            "Supertest",
            "Mocha",
        ],
    },
    {
        title: "Security & AI",
        level: "Edge-to-app",
        items: [
            "Helmet",
            "Rate Limiting",
            "OAuth2 / OIDC",
            "JWT",
            "OWASP",
            "OpenAI SDK",
            "Anthropic SDK",
        ],
    },
];

const allStudies = await getCollection("case-studies");
const projects = allStudies
    .sort((a, b) => a.data.order - b.data.order)
    .slice(0, 1)
    .map((s) => ({
        slug: `case-study/${s.id.replace(/\.md$/, "")}/`,
        title: s.data.title,
        context: s.data.context,
        period: s.data.period,
        tags: s.data.stack,
        summary: s.data.subtitle,
        metricValue: s.data.metric.value,
        metricLabel: s.data.metric.label,
    }));

const allArticles = await getCollection("articles");
const articles = allArticles
    .filter((a) => !a.data.draft)
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, 1)
    .map((a) => ({
        ...a,
        date: a.data.pubDate.toISOString().slice(0, 10),
        time: formatReadingTime(readingTime(a.body ?? "")),
    }));
---

<BaseLayout
    title="Thiego Moura — Backend Software Engineer"
    pageClass="page-home"
>
    <AsciiPortrait />

    <Hero
        title="I build backend systems that handle millions of requests without paging me at 3 AM."
        intro="Backend Software Engineer — Node.js · Nest.js · TypeScript · Cloud-native (AWS & Azure)."
        stats={stats}
    />

    <section class="section">
        <h2 class="section-title">What I deliver</h2>
        <ul class="marker-list">
            {
                deliverables.map((item) => (
                    <li>
                        <span>{item}</span>
                    </li>
                ))
            }
        </ul>
        <p class="section-cta">
            <a class="btn btn--ghost" href="/experience"
                >See full experience →</a
            >
        </p>
    </section>

    <section class="section">
        <h2 class="section-title">Skills</h2>
        <div class="skills-grid">
            {skills.map((group) => <SkillGroup {...group} />)}
        </div>
    </section>

    <section class="section">
        <h2 class="section-title">Select Articles</h2>
        {
            articles.length === 0 ? (
                <p class="empty mono">no articles published yet</p>
            ) : (
                <ul class="articles-list">
                    {articles.map((a) => (
                        <li>
                            <a
                                href={`/articles/${a.id.replace(/\.md$/, "")}/`}
                                class="article-link"
                            >
                                <span class="article-date mono">
                                    {a.date}
                                    <span class="article-meta-sep"> · </span>
                                    {a.time}
                                </span>
                                <span class="article-title">
                                    {a.data.title}
                                </span>
                                <span class="article-desc">
                                    {a.data.description}
                                </span>
                                {a.data.tags.length > 0 && (
                                    <span class="article-tags mono">
                                        {a.data.tags
                                            .map((t) => `#${t}`)
                                            .join(" ")}
                                    </span>
                                )}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
        <p class="section-cta">
            <a class="btn btn--ghost" href="/articles">See all articles →</a>
        </p>
    </section>

    <section class="section">
        <h2 class="section-title">Selected projects</h2>
        <div class="projects-list">
            {projects.map((project) => <ProjectCard {...project} />)}
        </div>
        <p class="section-cta">
            <a class="btn btn--ghost" href="/projects">See all projects →</a>
        </p>
        <a class="btn btn--ghost" href="/adrs">Read architecture decisions →</a>
    </section>
</BaseLayout>

<style>
    .skills-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 2rem;
    }

    .skills-grid :global(.skill-group) {
        border-top: 0;
        padding: 0.85rem 0;
        border-bottom: 1px solid var(--hairline);
    }

    .projects-list {
        display: flex;
        flex-direction: column;
    }

    .section-cta {
        margin-top: 1.5rem;
    }

    @media (max-width: 720px) {
        .skills-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
