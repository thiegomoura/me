---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const allStudies = await getCollection('case-studies');
const projects = allStudies
    .sort((a, b) => a.data.order - b.data.order)
    .map((s) => ({
        slug: `case-study/${s.id.replace(/\.md$/, '')}/`,
        title: s.data.title,
        context: s.data.context,
        period: s.data.period,
        tags: s.data.stack,
        summary: s.data.subtitle,
        metricValue: s.data.metric.value,
        metricLabel: s.data.metric.label,
    }));
---
<BaseLayout title="Projects" pageClass="page-projects">
    <header class="page-header reveal">
        <h1>Case Studies</h1>
        <p>
            Selected backend work with measurable impact. Each card opens a longer write-up with
            context, architecture, key decisions, and outcomes — the kind of detail that survives a
            senior interview whiteboard.
        </p>
    </header>

    <section class="section">
        <h2 class="section-title">All case studies</h2>
        <div class="projects-list">
            {projects.map((p) => <ProjectCard {...p} />)}
        </div>
        <p class="section-cta">
            <a class="btn btn--ghost" href="/adrs">Read architecture decisions →</a>
        </p>
    </section>
</BaseLayout>

<style>
    .page-header {
        padding: calc(var(--gutter) * 0.5) 0 var(--gutter);
    }

    .page-header h1 {
        font-size: clamp(1.9rem, 3.4vw, 2.4rem);
        line-height: 1.1;
        letter-spacing: -0.03em;
        margin: 0 0 0.7rem;
    }

    .page-header p {
        font-size: 1.02rem;
        line-height: 1.7;
        color: var(--text-muted);
        max-width: 60ch;
        margin: 0;
    }

    .projects-list {
        display: flex;
        flex-direction: column;
    }

    .section-cta {
        margin-top: 1.5rem;
    }
</style>
